# Skopíruj tento súbor ako .env.local a vyplň hodnoty

# Pripojenie na lokálnu PostgreSQL databázu
# Spustenie lokálne cez Docker: docker run --name vazimsi-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=vazimsi -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vazimsi

# SMTP (napr. Gmail + heslo aplikácie: https://myaccount.google.com/apppasswords)
# Objednávkové e-maily (potvrdenie zákazníkovi + notifikácia na settings.email) sa posielajú cez tento účet.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tvoj-obchod@gmail.com
SMTP_PASS=heslo-aplikacie

# Prihlasovacie údaje do administrácie (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zmen-toto-heslo

# Náhodný reťazec, min. 32 znakov, používa sa na podpisovanie session cookie
# Vygeneruješ napr. príkazom: openssl rand -base64 32
SESSION_SECRET=zmen-toto-na-nahodny-retazec-dlhy-aspon-32-znakov

# Ak web beží BEZ HTTPS (žiadny reverse proxy s TLS certifikátom pred aplikáciou),
# odkomentuj nasledujúci riadok - inak sa prihlásenie do /admin nebude dať uložiť
# (prehliadače ignorujú "Secure" cookies na obyčajnom http://).
# Len čo web beží na https://, tento riadok zmaž alebo nastav na "true".
# COOKIE_SECURE=false
